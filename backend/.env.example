# 复制成 .env 再填值；.env 已被 .gitignore 忽略，不要提交真实密钥
# 用法：uv sync && uv run uvicorn app.main:app --reload

# --- 数据库（BE-002 起生效）---
# 本地：sqlite:///./bababoi.db   生产：mysql+pymysql://user:pass@host:3306/bababoi?charset=utf8mb4
# 注意是 pymysql：后端用 sync SQLAlchemy（05 §9.2），aiomysql 驱动跑不起来
DATABASE_URL=

# --- 认证（FR-7）---
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_DAYS=7

# --- LLM（ADR-003：DeepSeek deepseek-flash，OpenAI 兼容）---
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# true = 不调真实模型，用假实现跑测试；CI 必须保持 true
LLM_MOCK=true
# 识图是否让模型先思考一遍。实测整页抄题：开 28.9s/5861 输出 token，关 3.4s/714 输出 token，
# 条目数与质量不降；开着时思考会顶满 max_tokens 变成"截断"。质量出问题再改回 true。
VISION_THINKING=false

# --- 跨域来源（逗号分隔的 JSON 数组）---
CORS_ORIGINS=["http://localhost:5173"]

# --- 队列与超时（PRD 5.4 / 5.6；ADR-006 三段并发后默认 6）---
TASK_MAX_CONCURRENCY=6
TASK_HARD_TIMEOUT_S=120
TASK_REQUEUE_DEADLINE_S=90
RECOGNIZE_CLIENT_TIMEOUT_S=90

# --- 图片（12号 §5 / BE-014）---
# 上传目录（相对路径按后端工作目录算）；库里存的 image_path 是 uploads/{user_id}/{name}
# 这个标识符，换目录只改这里，历史行仍能读
UPLOAD_DIR=./uploads
IMAGE_MAX_UPLOAD_BYTES=10485760
IMAGE_MAX_STORED_BYTES=5242880
IMAGE_MAX_EDGE_PX=2000
# 送多模态模型前的临时缩放长边（只在内存里做，不落第二份文件）
IMAGE_LLM_MAX_EDGE_PX=1200
IMAGE_ALLOWED_TYPES=["image/jpeg","image/png","image/webp"]

# --- 录入草稿（05 §6.5b）---
# PUT /drafts/me 的 content 序列化后字节上限；超限 400
DRAFT_MAX_BYTES=262144

# --- 反向代理（issue #11）---
# 只有直连来源在这个列表里时才采信 X-Forwarded-For；nginx 部署时填 nginx 的 IP。
# 留空 = 不信任任何代理头，登录限流按 socket 对端计（单机直连有效）。
TRUSTED_PROXIES=[]
