# 复制成 .env 再填值；.env 已被 .gitignore 忽略，不要提交真实密钥
# 用法：uv sync && uv run uvicorn app.main:app --reload

# --- 数据库（BE-002 起生效）---
# 本地：sqlite:///./bababoi.db   生产：mysql+pymysql://user:pass@host:3306/bababoi?charset=utf8mb4
# 注意是 pymysql：后端用 sync SQLAlchemy（05 §9.2），aiomysql 驱动跑不起来
DATABASE_URL=

# --- 认证（FR-7）---
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_DAYS=7

# --- LLM（ADR-003：DeepSeek deepseek-flash，OpenAI 兼容）---
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# true = 不调真实模型，用假实现跑测试；CI 必须保持 true
LLM_MOCK=true

# --- 跨域来源（逗号分隔的 JSON 数组）---
CORS_ORIGINS=["http://localhost:5173"]

# --- 队列与超时（PRD 5.4 / 5.6；并发上限待 RPM/TPM 实测后调）---
TASK_MAX_CONCURRENCY=2
TASK_HARD_TIMEOUT_S=120
RECOGNIZE_CLIENT_TIMEOUT_S=90

# --- 反向代理（issue #11）---
# 只有直连来源在这个列表里时才采信 X-Forwarded-For；nginx 部署时填 nginx 的 IP。
# 留空 = 不信任任何代理头，登录限流按 socket 对端计（单机直连有效）。
TRUSTED_PROXIES=[]
