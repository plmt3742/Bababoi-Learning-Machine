# 复制到 /srv/bababoi/.env（chmod 600），不要把真值提交进仓库。
# 注意：DATABASE_URL / UPLOAD_DIR 由 docker-compose.yml 固定为 /data 下，不在这里配。

APP_ENV=staging

# 必填：≥32 字节。生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# seed 用；只写演示手册，不进仓库
DEMO_PASSWORD=

# 先 mock 跑通链路，验收前切 false 并填真 Key
LLM_MOCK=true
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# list 字段必须写 JSON 数组（裸写或留空会让进程启动即报 SettingsError）
CORS_ORIGINS=["http://<服务器IP>"]
TRUSTED_PROXIES=["127.0.0.1"]

RECOGNIZE_CLIENT_TIMEOUT_S=180
VISION_FORCE_REFRESH_COOLDOWN_S=60
