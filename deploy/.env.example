# 复制到 /srv/bababoi/.env（chmod 600），不要把真值提交进仓库。
# 注意：DATABASE_URL / UPLOAD_DIR 由 docker-compose.yml 固定为 /data 下，不在这里配。

APP_ENV=staging

# 必填：≥32 字节。生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# seed 用；只写演示手册，不进仓库
DEMO_PASSWORD=

# 先 mock 跑通链路，验收前切 false 并填真 Key
LLM_MOCK=true
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# list 字段必须写 JSON 数组（裸写或留空会让进程启动即报 SettingsError）
CORS_ORIGINS=["http://<服务器IP>"]
# 反代/容器部署必须含后端看到的"对端"网段（支持 CIDR）。Docker 下对端是网桥网关，
# 只写 127.0.0.1 会让登录/注册限流退化成"全站一个桶"。
# 查实际网段：docker network inspect <项目>_default --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
# 想更严格可把 172.16.0.0/12 换成查到的具体网段（如 172.19.0.0/16）。
TRUSTED_PROXIES=["127.0.0.1", "172.16.0.0/12"]

RECOGNIZE_CLIENT_TIMEOUT_S=180
VISION_FORCE_REFRESH_COOLDOWN_S=60

# BYOK（用户自带 Key）：Fernet key，44 字符。缺失时 `PUT /settings/ai` 返回 503，其余功能不受影响。
# 生成：python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# 这个 key 与数据同寿命：更换 = 先清空 user_ai_settings，否则已存密文全部解不开。
SETTINGS_ENCRYPTION_KEY=
