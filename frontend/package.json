    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@arco-design/web-vue": "2.59.0",
    "axios": "1.21.0",
    "pinia": "3.0.4",
    "vue": "3.5.44",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitejs/plugin-vue": "6.0.10",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "unplugin-vue-components": "^32.1.0",
    "vite": "8.3.5",
    "vue-tsc": "3.3.14"
  },
  "engines": {
    "node": ">=22.12.0"
  }
